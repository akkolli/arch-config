# KDE/Qt apps such as Dolphin read these values too.
cat > "$HOME/.config/kdeglobals" <<KDE
[General]
font=$FONT_UI_FAMILY,11,-1,5,400,0,0,0,0,0
fixed=$FONT_MONO_FAMILY,11,-1,5,400,0,0,0,0,0
smallestReadableFont=$FONT_UI_FAMILY,9,-1,5,400,0,0,0,0,0
toolBarFont=$FONT_UI_FAMILY,11,-1,5,400,0,0,0,0,0
menuFont=$FONT_UI_FAMILY,11,-1,5,400,0,0,0,0,0

[Icons]
Theme=$ICON_THEME_NAME
KDE

# Reload Hyprland config.
hyprctl reload >/dev/null 2>&1 || true

# Restart Waybar without leaving the session without a bar if startup fails.
safe_restart waybar /tmp/waybar-theme.log waybar || true

# Reload or start Mako.
if pgrep -x mako >/dev/null; then
  makoctl reload >/dev/null 2>&1 || true
else
  mako >/tmp/mako-theme.log 2>&1 &
  disown >/dev/null 2>&1 || true
fi

# Apply wallpaper through Hyprpaper IPC; restart only if IPC is unavailable.
if [ -n "$wall" ]; then
  apply_wallpaper
fi

echo "Applied $NAME theme."

if [ -n "$wall" ]; then
  echo "Wallpaper: $wall"
else
  echo "No wallpaper found for $theme."
  echo "Put one here:"
  echo "$HOME/.config/themes/wallpapers/${theme}.jpg"
fi

echo "Ghostty config updated."
echo "Open a new Ghostty window to see terminal color changes."
echo "Starship prompt updated."
echo "Font: $FONT_UI"
