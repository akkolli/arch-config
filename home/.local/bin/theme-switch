  "$HOME/.config/gtk-4.0" \
  "$HOME/.config/hypr" \
  "$HOME/.config/qt5ct" \
  "$HOME/.config/qt6ct" \
  "$HOME/.config/theme" \
  "$HOME/.config/themes/wallpapers" \
  "$HOME/.icons/default" \
  "$HOME/.local/share/icons/default"

# Find wallpaper, case-insensitive.
wall="$(find "$HOME/.config/themes/wallpapers" -maxdepth 1 -type f \
  \( -iname "${theme}.png" -o \
     -iname "${theme}.jpg" -o \
     -iname "${theme}.jpeg" -o \
     -iname "${theme}.webp" -o \
     -iname "${theme}.jxl" -o \
     -iname "${theme}.avif" \) \
  -print -quit 2>/dev/null || true)"

if [ -n "$wall" ]; then
  wall="$(realpath "$wall")"
fi

