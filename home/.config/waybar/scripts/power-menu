#!/usr/bin/env bash
set -euo pipefail

choice="$(
  printf 'lock\nsuspend\nlogout\nreboot\nshutdown\n' |
    rofi -dmenu -p Power -theme-str 'window { width: 280px; }' || true
)"

[ -n "$choice" ] || exit 0

case "$choice" in
  lock)
    "$HOME/.local/share/quickshell-lockscreen/lock.sh"
    ;;
  suspend)
    systemctl suspend
    ;;
  logout)
    if command -v hyprshutdown >/dev/null 2>&1; then
      hyprshutdown
    else
      hyprctl dispatch 'hl.dsp.exit()'
    fi
    ;;
  reboot)
    systemctl reboot
    ;;
  shutdown)
    systemctl poweroff
    ;;
esac
