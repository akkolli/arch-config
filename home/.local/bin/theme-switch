hex() {
  echo "${1#\#}"
}

sgr_rgb() {
  local value="${1#\#}"
  printf '%d;%d;%d' "0x${value:0:2}" "0x${value:2:2}" "0x${value:4:2}"
}

ACCENT_RGB="$(hex "$ACCENT")"
BLUE_RGB="$(hex "$BLUE")"
SURFACE2_RGB="$(hex "$SURFACE2")"
BG_RGB="$(hex "$BG")"
FG_RGB="$(hex "$FG")"
RED_RGB="$(hex "$RED")"
YELLOW_RGB="$(hex "$YELLOW")"
LS_DIR_RGB="$(sgr_rgb "$TERM_GREEN")"
LS_LINK_RGB="$(sgr_rgb "$TERM_CYAN")"
LS_EXEC_RGB="$(sgr_rgb "$TERM_BRIGHT_GREEN")"
LS_ARCHIVE_RGB="$(sgr_rgb "$TERM_YELLOW")"
LS_IMAGE_RGB="$(sgr_rgb "$TERM_MAGENTA")"
LS_AUDIO_RGB="$(sgr_rgb "$TERM_MAGENTA")"
LS_WARN_RGB="$(sgr_rgb "$TERM_YELLOW")"
LS_ERROR_RGB="$(sgr_rgb "$TERM_RED")"
PROMPT_ACCENT_RGB="$(sgr_rgb "$ACCENT")"
PROMPT_MUTED_RGB="$(sgr_rgb "$MUTED")"
PROMPT_PATH_RGB="$(sgr_rgb "$TERM_GREEN")"
PROMPT_FG_RGB="$(sgr_rgb "$FG")"
