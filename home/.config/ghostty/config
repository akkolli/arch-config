# Generated by theme-switch. Edit ~/.local/bin/theme-switch to change this profile.
font-family = JetBrainsMono Nerd Font
font-family-bold = JetBrainsMono Nerd Font
font-family-italic = JetBrainsMono Nerd Font
font-family-bold-italic = JetBrainsMono Nerd Font
font-size = 15
font-synthetic-style = bold,italic,bold-italic

theme = theme-switch-active

minimum-contrast = 1.15
bold-color = bright
faint-opacity = 0.58

background-opacity = 0.82
background-opacity-cells = false
background-blur = false

cursor-style = block
cursor-style-blink = false
cursor-text = cell-background
cursor-click-to-move = true

mouse-hide-while-typing = true
copy-on-select = true
selection-clear-on-copy = false
selection-clear-on-typing = true

window-padding-x = 14
window-padding-y = 12
window-padding-balance = true
window-padding-color = background
window-decoration = false
window-inherit-working-directory = true
tab-inherit-working-directory = true
split-inherit-working-directory = true

gtk-titlebar = false
gtk-tabs-location = hidden
gtk-toolbar-style = flat
gtk-wide-tabs = false

shell-integration = detect
shell-integration-features = cursor,title,path,no-sudo,no-ssh-env,no-ssh-terminfo
app-notifications = no-clipboard-copy,config-reload

keybind = ctrl+shift+r=reload_config
keybind = ctrl+shift+enter=toggle_split_zoom
keybind = ctrl+shift+\=new_split:right
keybind = ctrl+shift+-=new_split:down
