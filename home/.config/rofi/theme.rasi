* {
  bg: #1b1420;
  bg2: #241827;
  surface: #302133;
  surface2: #49304b;
  fg: #fff0dc;
  muted: #c8aeb0;
  accent: #ffb15c;
  blue: #a9d4df;
  yellow: #ffe0a8;
  red: #d985a3;

  background-color: transparent;
  text-color: @fg;
}

window {
  width: 42%;
  border-radius: 10px;
  background-color: @bg;
  border: 1px;
  border-color: @surface2;
  padding: 16px;
}

mainbox {
  spacing: 12px;
}

inputbar {
  background-color: @surface;
  border-radius: 8px;
  padding: 10px 12px;
  spacing: 10px;
}

prompt {
  text-color: @accent;
}

entry {
  placeholder: "Search";
  placeholder-color: @muted;
}

listview {
  columns: 1;
  lines: 8;
  spacing: 6px;
  fixed-height: true;
}

element {
  padding: 10px 12px;
  border-radius: 8px;
}

element selected {
  background-color: @surface2;
}

element urgent,
element selected urgent {
  text-color: @red;
}

element-icon {
  size: 24px;
  margin: 0 10px 0 0;
}

element-text {
  text-color: @fg;
}

element selected element-text {
  text-color: @accent;
}

message {
  border-radius: 8px;
  background-color: @surface;
  padding: 10px;
}

textbox {
  text-color: @fg;
}
