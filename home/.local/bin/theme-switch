GTK_THEME_NAME="Materia-dark"
ICON_THEME_NAME="Papirus-Dark"
CURSOR_THEME_NAME="capitaine-cursors"
CURSOR_SIZE=24

hypr_monitors() {
  if command -v jq >/dev/null 2>&1; then
    hyprctl monitors -j 2>/dev/null | jq -r '.[].name' 2>/dev/null || true
  else
    hyprctl monitors 2>/dev/null | awk '/^Monitor / {print $2}' || true
  fi
}

safe_restart() {
  local name="$1"
  local log="$2"
  shift 2

  local unit="" action="restart"
  case "$name" in
    waybar)
      unit="waybar-hyprland.service"
      action="reload-or-restart"
      ;;
    hyprpaper)
      unit="hyprpaper.service"
      ;;
  esac

  if [ -n "$unit" ] && command -v systemctl >/dev/null 2>&1 &&
     systemctl --user cat "$unit" >/dev/null 2>&1; then
    if systemctl --user "$action" "$unit"; then
      return 0
    fi
    echo "Failed to $action $unit. Check its user journal."
    return 1
  fi

  local old_pids pid new_pid
  old_pids="$(pgrep -x "$name" || true)"
  "$@" >"$log" 2>&1 &
  new_pid=$!
  disown "$new_pid" >/dev/null 2>&1 || true

  sleep 1
  if ! kill -0 "$new_pid" >/dev/null 2>&1; then
    echo "Failed to start $name. See $log."
    return 1
  fi

  if [ -n "$old_pids" ]; then
    while IFS= read -r pid; do
      [ -n "$pid" ] || continue
      kill "$pid" >/dev/null 2>&1 || true
    done <<<"$old_pids"
  fi
}

apply_wallpaper() {
  [ -n "$wall" ] || return 0

  if ! pgrep -x hyprpaper >/dev/null 2>&1; then
    safe_restart hyprpaper /tmp/hyprpaper-theme.log hyprpaper || true
    sleep 1
  fi

  local applied=0 monitor

  while IFS= read -r monitor; do
    [ -n "$monitor" ] || continue
    if hyprctl hyprpaper wallpaper "$monitor,$wall,cover" >/dev/null 2>&1; then
      applied=1
    fi
  done < <(hypr_monitors)

  if [ "$applied" -eq 0 ]; then
    if hyprctl hyprpaper wallpaper ",$wall,cover" >/dev/null 2>&1; then
      applied=1
    fi
  fi

  if [ "$applied" -eq 0 ]; then
    safe_restart hyprpaper /tmp/hyprpaper-theme.log hyprpaper || true
  fi
}

mkdir -p \
  "$HOME/.config/ghostty" \
  "$HOME/.config/ghostty/themes" \
  "$HOME/.config/waybar" \
  "$HOME/.config/rofi" \
  "$HOME/.config/mako" \
