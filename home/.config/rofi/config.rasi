configuration {
  modi: "drun,run,window";
  show-icons: true;
  icon-theme: "Papirus-Dark";
  font: "JetBrainsMono Nerd Font Propo 11";
  terminal: "ghostty";
  drun-display-format: "{name}";
  display-drun: "apps";
  display-run: "run";
  display-window: "windows";
  matching: "fuzzy";
  sorting-method: "fzf";
  scroll-method: 0;
  sidebar-mode: false;
}
@theme "~/.config/rofi/theme.rasi"
